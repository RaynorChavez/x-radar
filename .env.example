# split: collector + OpenAI Sites. single: collector + local dashboard.
XRADAR_MODE=split
XRADAR_SITE_URL=https://your-private-site.example
XRADAR_INGEST_TOKEN=replace-with-a-random-secret
# Required only when the dashboard is protected by the OpenAI Sites sign-in gate.
XRADAR_SITE_BYPASS_TOKEN=replace-with-your-private-site-bypass-token
XRADAR_HOST=collector
# mixed: topic-driven 150-post periods. legacy: one 100-post Home target.
XRADAR_ACQUISITION_MODE=mixed
# pipeline: deterministic Firefox -> raw JSON -> bounded fresh Luna calls.
# agent: previous single-session Codex orchestrator, retained as a rollback.
XRADAR_COLLECTOR_ORCHESTRATION=pipeline
# Independent durable Luna ranking batches processed at once (1-4).
XRADAR_LUNA_CONCURRENCY=2

# Optional absolute Codex CLI path. The collector intentionally uses gpt-5.6-luna.
# XRADAR_CODEX_BIN=/home/example/.local/bin/codex
# Keep 0 for normal installs. Set 1 only when a dedicated service account is
# independently confined by a hardened systemd unit or an equivalent host sandbox.
XRADAR_CODEX_UNSANDBOXED=0

# Optional server-side semantic search. Install it with:
# python3 tools/install_embedding_model.py
# XRADAR_EMBEDDING_MODEL_DIR=/home/example/x-radar/var/models/bge-small-en-v1.5-onnx
# XRADAR_SEMANTIC_LOCAL_MODE=1
