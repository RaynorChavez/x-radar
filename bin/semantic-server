#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="${XRADAR_SEMANTIC_PYTHON:-python3}"
exec "$PYTHON" -m xradar.semantic --db "${XRADAR_DATABASE:-var/x-radar.sqlite}" serve \
  --host "${XRADAR_SEMANTIC_HOST:-127.0.0.1}" --port "${XRADAR_SEMANTIC_PORT:-8777}"
