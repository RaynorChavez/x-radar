<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xradar.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>__XRADAR_HOME__/bin/collect-once</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>WorkingDirectory</key>
  <string>__XRADAR_HOME__</string>
  <key>StandardOutPath</key>
  <string>__XRADAR_HOME__/var/collector.log</string>
  <key>StandardErrorPath</key>
  <string>__XRADAR_HOME__/var/collector.err</string>
</dict>
</plist>
