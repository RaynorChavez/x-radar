[Unit]
Description=x-radar loopback semantic search
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/x-radar
ExecStart=%h/x-radar/bin/semantic-server
EnvironmentFile=%h/x-radar/.env
Environment=HOME=%h
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
